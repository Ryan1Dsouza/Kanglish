<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <Spinner android:id="@+id/dictionaryLanguage" android:layout_width="match_parent" android:layout_height="48dp" />
    <EditText android:id="@+id/dictionaryOriginal" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Word or phrase" android:inputType="textMultiLine|textCapSentences" android:maxLength="4000" android:minHeight="56dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
    <EditText android:id="@+id/dictionaryEnglish" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Your English meaning" android:inputType="textMultiLine|textCapSentences" android:maxLength="4000" android:minHeight="56dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
</LinearLayout>
