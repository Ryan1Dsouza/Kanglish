<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark">
        <LinearLayout android:id="@+id/audioControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAudioBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/audio_back" android:textAllCaps="false" android:textColor="@color/action_text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_title" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_description" android:textColor="@color/text_secondary" android:textSize="15sp" android:layout_marginTop="8dp" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchAudioOnline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/audio_allow_online" android:textColor="@color/text_primary" android:minHeight="48dp" android:checked="false" app:useMaterialThemeColors="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_privacy" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/tvAudioStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/audio_ready" android:textColor="@color/primary_light" android:textSize="16sp" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAudioStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/audio_start" android:textAllCaps="false" android:minHeight="48dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAudioStop" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/audio_stop" android:textAllCaps="false" android:textColor="@color/action_text" android:minHeight="48dp" android:enabled="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAudioPip" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Float" android:textAllCaps="false" android:textColor="@color/action_text" android:minHeight="48dp" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchAudioSource" android:layout_width="match_parent" android:layout_height="48dp" android:text="Show original below English" android:textColor="@color/text_secondary" app:useMaterialThemeColors="true" />
        </LinearLayout>
            <ScrollView android:id="@+id/audioTranscriptScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:background="@color/surface_dark" android:padding="16dp" android:fillViewport="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/tvAudioTranscript" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_empty" android:textColor="@color/text_primary" android:textSize="21sp" android:textIsSelectable="true" />
                    <TextView android:id="@+id/tvAudioPartialLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/audio_partial" android:textColor="@color/text_secondary" android:textSize="12sp" android:visibility="gone" />
                    <TextView android:id="@+id/tvAudioPartial" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/primary_light" android:textSize="21sp" android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        <LinearLayout android:id="@+id/audioFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAudioCopy" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/audio_copy" android:textAllCaps="false" android:textColor="@color/action_text" android:minHeight="48dp" android:enabled="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAudioClear" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/audio_clear" android:textAllCaps="false" android:textColor="@color/action_text" android:minHeight="48dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_help" android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>
</LinearLayout>
