<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feedback_dialog_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/dialogTvOriginal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Original: ..."
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/dialogTvCurrentTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current Translation: ..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/feedback_correction_hint"
        android:textColorHint="@color/text_muted"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCorrection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top|start"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Private local storage only. Chats are NEVER uploaded or collected without consent."
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
