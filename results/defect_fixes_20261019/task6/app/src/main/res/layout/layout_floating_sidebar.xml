<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="56dp" android:layout_height="56dp" android:id="@+id/pillHandle" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_floating_pill" android:contentDescription="Paste copied text with Kanglish" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="K" android:textSize="22sp" android:textColor="@color/text_primary" android:gravity="center" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="344dp" android:layout_height="wrap_content" android:id="@+id/panelExpanded" android:orientation="vertical" android:visibility="gone" android:background="@drawable/bg_floating_panel" android:padding="8dp" android:elevation="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="48dp" android:id="@+id/panelHeader" android:text="Kanglish" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_weight="1" android:textStyle="bold" android:gravity="center_vertical" />
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnMinimize" android:text="_" android:textSize="14sp" android:textColor="@color/primary_light" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Minimize" />
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnCloseOverlay" android:text="X" android:textSize="14sp" android:textColor="@color/primary_light" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Close bubble" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/btnFloatingPaste" android:text="Paste copied text" android:textSize="14sp" android:textColor="@color/primary_light" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Paste copied text" />
        <org.kanglish.app.overlay.MaxHeightScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/panelScroll" android:scrollbars="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copied message" android:textSize="13sp" android:textColor="@color/text_secondary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvFloatingOriginal" android:text="Copy a message in WhatsApp, then tap Paste copied text." android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="English" android:textSize="13sp" android:textColor="@color/translated_border" android:layout_marginTop="12dp" />
                <ProgressBar android:layout_width="24dp" android:layout_height="24dp" android:id="@+id/pbFloatingTranslating" android:visibility="gone" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvFloatingTranslated" android:text="Your translation appears here." android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginTop="4dp" android:textIsSelectable="true" android:accessibilityLiveRegion="polite" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/boxFloatingTeacher" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvFloatingTeacherBadge" android:text="Cloud review" android:textSize="13sp" android:textColor="@color/teacher_badge" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvFloatingTeacherText" android:text="" android:textSize="14sp" android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:id="@+id/btnFloatingTeach" android:text="Save meaning" android:textSize="14sp" android:textColor="@color/primary_light" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Save meaning" />
                </LinearLayout>
            </LinearLayout>
        </org.kanglish.app.overlay.MaxHeightScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:id="@+id/btnFloatingCopy" android:text="Copy translation" android:textSize="14sp" android:textColor="@color/primary_light" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Copy translation" />
            <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:id="@+id/btnFloatingOpenApp" android:text="Open app" android:textSize="14sp" android:textColor="@color/primary_light" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Open app" />
            <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:id="@+id/btnFloatingClear" android:text="Clear" android:textSize="14sp" android:textColor="@color/primary_light" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:contentDescription="Clear" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
