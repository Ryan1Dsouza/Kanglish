<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kanglish" android:textSize="22sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvEngineStatusHeader" android:text="On-device translation" android:textSize="13sp" android:textColor="@color/status_ready" android:paddingBottom="8dp" />
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout android:layout_width="match_parent" android:layout_height="56dp" android:id="@+id/tabLayout" app:tabMode="fixed" app:tabIndicatorColor="@color/primary_light" app:tabSelectedTextColor="@color/text_primary" app:tabTextColor="@color/text_secondary" android:background="@color/surface_dark">
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Translate" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chats" />
        <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" />
    </com.google.android.material.tabs.TabLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/viewImportTab" android:fillViewport="true" android:visibility="visible">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kanglish in. English out." android:textSize="24sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Paste a message or type it below." android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAudioCaptions" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_title" android:textAllCaps="false" android:textColor="@color/action_text" android:minHeight="48dp" android:layout_marginBottom="12dp" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_marginBottom="8dp" app:hintTextColor="@color/text_secondary">
                    <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etPasteInput" android:hint="Your Kanglish message" android:textColor="@color/text_primary" android:inputType="textCapSentences|textMultiLine" android:minLines="4" android:maxLines="8" android:gravity="top" android:imeOptions="flagNoPersonalizedLearning" android:importantForAutofill="no" android:textColorHint="@color/text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/btnPasteClipboard" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Paste" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                    <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/btnClearPasteText" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Clear" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnParsePaste" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:text="Translate" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/quickResultCard" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/surface_dark" app:cardCornerRadius="16dp" app:strokeColor="@color/surface_card" app:strokeWidth="1dp" android:visibility="gone" android:layout_marginTop="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:id="@+id/tvQuickTranslationLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/local_translation_title" android:textSize="14sp" android:textColor="@color/translated_border" android:paddingBottom="8dp" />
                        <ProgressBar android:layout_width="32dp" android:layout_height="32dp" android:id="@+id/pbQuickTranslating" android:visibility="gone" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvQuickResult" android:text="" android:textSize="18sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" android:textIsSelectable="true" android:accessibilityLiveRegion="polite" />
                        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnCopyQuick" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Copy translation" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quickTeacherCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/teacher_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/surface_card"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quick_teacher_title" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" android:paddingBottom="8dp" />
                        <ProgressBar android:id="@+id/pbQuickTeacher" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone" android:layout_marginBottom="8dp" />
                        <TextView android:id="@+id/tvQuickTeacherStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/teacher_badge" android:paddingBottom="8dp" android:accessibilityLiveRegion="polite" />
                        <TextView android:id="@+id/tvQuickTeacherTranslation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" android:textIsSelectable="true" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                        <TextView android:id="@+id/tvQuickTeacherExplanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" android:visibility="gone" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnApproveQuickTeacher" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:text="@string/approve_teacher_correction" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:visibility="gone" />
                        <TextView android:id="@+id/tvQuickLearningStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingVertical="8dp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnForgetQuickCorrection" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="@string/forget_correction" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" android:visibility="gone" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnCopyQuickTeacher" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="@string/quick_teacher_copy" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" android:visibility="gone" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnRetryQuickTeacher" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="@string/quick_teacher_retry" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" android:visibility="gone" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnQuickTeacherSettings" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="@string/quick_teacher_settings" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="For WhatsApp: enable the floating bubble in Settings. Copy a message, then tap the bubble." android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" android:layout_marginTop="20dp" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/viewChatTab" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp">
                <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/btnImportFile" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Import chat" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/btnLoadSampleChat" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Try sample" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp">
                <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/btnQuickTranslateAll" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Translate all" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/btnClearChat" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Clear" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/tvEmptyChat" android:text="Import a WhatsApp .txt export to translate messages with their conversation context." android:textSize="16sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" android:layout_weight="1" android:gravity="center" android:padding="24dp" />
            <androidx.recyclerview.widget.RecyclerView android:layout_width="match_parent" android:layout_height="0dp" android:id="@+id/rvMessages" android:layout_weight="1" android:clipToPadding="false" android:paddingVertical="8dp" android:visibility="gone" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/viewModelTab" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings" android:textSize="24sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/surface_dark" app:cardCornerRadius="16dp" app:strokeColor="@color/surface_card" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Offline model" android:textSize="18sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Qwen2.5 0.5B / Q4_K_M" android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvModelStatus" android:text="Checking model..." android:textSize="14sp" android:textColor="@color/status_pending" android:paddingBottom="8dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvModelDetails" android:text="" android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnPickModel" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:text="Choose 0.5B GGUF" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" />
                        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnUnloadModel" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Unload model" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/surface_dark" app:cardCornerRadius="16dp" app:strokeColor="@color/surface_card" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <com.google.android.material.switchmaterial.SwitchMaterial android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/switchFloatingSidebar" android:text="WhatsApp floating bubble" android:textColor="@color/text_primary" android:textSize="16sp" android:minHeight="48dp" app:useMaterialThemeColors="true" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvSidebarStatus" android:text="" android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Copy a message in WhatsApp.\n2. Tap the Kanglish bubble.\n3. Read or copy the translation." android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnTestSidebar" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Show bubble" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Optional: hold detection" android:textSize="16sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" android:layout_marginTop="12dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Experimental. Copy and tap works without accessibility access." android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnEnableAccessibility" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Set up hold detection" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvAccessibilityIndicator" android:text="" android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnAdvancedSettings" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Cloud review settings" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/cloudSettings" android:orientation="vertical" android:visibility="gone" android:padding="16dp">
                    <com.google.android.material.switchmaterial.SwitchMaterial android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/switchTeacherEnabled" android:text="Enable cloud review" android:textColor="@color/text_primary" android:textSize="16sp" android:minHeight="48dp" app:useMaterialThemeColors="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="When enabled, original messages and translations from Translate, Chats and the bubble are sent to your configured provider. Leave off for on-device translation only." android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvTeacherStatus" android:text="" android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_marginBottom="8dp" app:hintTextColor="@color/text_secondary">
                        <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etGeminiKey" android:hint="Gemini API key" android:textColor="@color/text_primary" android:inputType="textPassword" android:minLines="1" android:maxLines="8" android:gravity="top" android:imeOptions="flagNoPersonalizedLearning" android:importantForAutofill="no" android:textColorHint="@color/text_secondary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_marginBottom="8dp" app:hintTextColor="@color/text_secondary">
                        <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/etGroqKey" android:hint="Groq API key" android:textColor="@color/text_primary" android:inputType="textPassword" android:minLines="1" android:maxLines="8" android:gravity="top" android:imeOptions="flagNoPersonalizedLearning" android:importantForAutofill="no" android:textColorHint="@color/text_secondary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnSaveTeacherSettings" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Save keys" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnOpenFeedback" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Saved corrections" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
            </LinearLayout>
        </ScrollView>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/viewFeedbackTab" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnBackToSettings" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Back to settings" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved corrections" android:textSize="24sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stored on this phone." android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                <TextView android:id="@+id/tvApprovedExamplesCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/approved_training_help" android:textSize="14sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnExportApprovedTraining" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="@string/export_approved_training" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
                <LinearLayout android:id="@+id/approvedCorrectionsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvFeedbackEmpty" android:text="No feedback notes yet." android:textSize="16sp" android:textColor="@color/text_secondary" android:paddingBottom="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvFeedbackList" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:paddingBottom="8dp" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/btnClearFeedback" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="Clear feedback notes" android:textAllCaps="false" android:textSize="14sp" android:minHeight="48dp" app:cornerRadius="12dp" android:letterSpacing="0" android:textColor="@color/action_text" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
